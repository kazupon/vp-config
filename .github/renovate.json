{
  "automerge": true,
  "extends": ["config:recommended", ":preserveSemverRanges", "helpers:pinGitHubActionDigests"],
  "labels": ["deps"],
  "major": {
    "automerge": false
  },
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "vp pack (tsdown) detects TypeScript 7 only with the `7.0` version prefix",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.1.0"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the latest vite-plus version in the CI compatibility matrix",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+- '(?<currentValue>[^']+)'"
      ]
    }
  ]
}
