{
  "name": "@kazupon/vp-config",
  "version": "1.0.0-rc.1",
  "description": "Vite Plus configuration for @kazupon",
  "homepage": "https://github.com/kazupon/vp-config#readme",
  "bugs": {
    "url": "https://github.com/kazupon/vp-config/issues"
  },
  "license": "MIT",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/vp-config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "docs": "node scripts/generate-docs.mjs",
    "dev": "vp pack --watch",
    "test": "vp test",
    "changelog": "gh-changelogen --repo=kazupon/vp-config",
    "typecheck": "tsc --noEmit",
    "typecheck:compat": "tsc -p tsconfig.types.json",
    "typecheck:compat:packaged": "node scripts/typecheck-packaged-consumer.mjs",
    "prepublishOnly": "pnpm run build",
    "prepack": "vp pack",
    "knip": "knip",
    "release": "bumpp",
    "prepare": "vp config"
  },
  "dependencies": {
    "@kazupon/eslint-plugin": "^0.7.1",
    "@ox-jsdoc/eslint-plugin-jsdoc": "^0.0.19",
    "eslint-plugin-regexp": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "bumpp": "^12.0.0",
    "gh-changelogen": "^2.0.0",
    "knip": "^6.0.0",
    "pkg-pr-new": "^0.0.88",
    "typescript": "~7.0.2",
    "vite-plus": "catalog:",
    "vitepress-api-references": "^0.3.0"
  },
  "peerDependencies": {
    "vite-plus": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "vite-plus": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.5.1"
}
