{
  "name": "@kazupon/vp-config",
  "version": "0.5.0",
  "description": "Vite Plus configuration for @kazupon",
  "homepage": "https://github.com/kazupon/vp-config#readme",
  "bugs": {
    "url": "https://github.com/kazupon/vp-config/issues"
  },
  "license": "MIT",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/vp-config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "docs": "node scripts/generate-docs.mjs",
    "dev": "vp pack --watch",
    "test": "vp test",
    "changelog": "gh-changelogen --repo=kazupon/vp-config",
    "typecheck": "tsgo --noEmit",
    "prepublishOnly": "pnpm run build",
    "prepack": "vp pack",
    "knip": "knip",
    "release": "bumpp --commit \"release: v%s\" --all --push --tag",
    "prepare": "vp config"
  },
  "dependencies": {
    "@kazupon/eslint-plugin": "^0.7.1",
    "@ox-jsdoc/eslint-plugin-jsdoc": "^0.0.19",
    "eslint-plugin-regexp": "^3.1.0"
  },
  "devDependencies": {
    "@oxc-project/types": "0.136.0",
    "@types/chai": "5.2.3",
    "@types/deep-eql": "4.0.2",
    "@types/node": "^25.9.2",
    "@typescript/native-preview": "7.0.0-dev.20260615.1",
    "assertion-error": "2.0.1",
    "bumpp": "^11.1.0",
    "gh-changelogen": "^0.2.8",
    "knip": "^6.0.0",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "pkg-pr-new": "^0.0.75",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitepress-api-references": "^0.2.0"
  },
  "packageManager": "pnpm@11.6.0",
  "inlinedDependencies": {
    "@oxc-project/types": "0.133.0",
    "@types/chai": "5.2.3",
    "@types/deep-eql": "4.0.2",
    "@voidzero-dev/vite-plus-core": "0.1.24",
    "@voidzero-dev/vite-plus-test": "0.1.24",
    "assertion-error": "2.0.1",
    "oxfmt": "0.52.0",
    "oxlint": "1.67.0",
    "vite-plus": "0.1.24"
  }
}
